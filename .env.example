# Development-only defaults for the local stack (REQ-WP-001, FR-006).
# Copy to .env and edit only if a port clashes. Never commit .env.

# Where the stack keeps its data (REQ-WP-065). A directory, not a Docker named
# volume, so it can be moved, copied and backed up with ordinary tools. On a
# server set this to the mounted disk; `make data-dirs` prepares it.
CHANNELFLOW_DATA_DIR=./data

# What address every published port binds to (REQ-WP-072, PRD §34). The default
# means the stack is reachable only from the host itself -- over an SSH tunnel,
# or by another container on the same network. Set it to 0.0.0.0 only when you
# have decided a service should be reachable from elsewhere, and remember that
# Docker's published ports bypass the INPUT chain `ufw` manages by default.
CHANNELFLOW_BIND_ADDRESS=127.0.0.1

# The public read API's limits (PRD §34, Principle X). CHANNELFLOW_RATE_LIMIT
# empty means no limiting at all -- a state chosen by leaving it unset, never a
# number nobody picked. /readyz and /metrics are never limited.
# CHANNELFLOW_CORS_ORIGINS is a comma-separated list; empty allows no
# cross-origin read at all, and "*" is refused at startup.
CHANNELFLOW_CORS_ORIGINS=
CHANNELFLOW_RATE_LIMIT=
CHANNELFLOW_RATE_WINDOW_SECONDS=60

POSTGRES_USER=channelflow
POSTGRES_PASSWORD=channelflow_dev_only
POSTGRES_DB=channelflow
POSTGRES_PORT=5432

MINIO_ROOT_USER=channelflow
MINIO_ROOT_PASSWORD=channelflow_dev_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=channelflow-dev

# Telegram alerting (REQ-WP-008). Names only -- never paste a real token here.
# The alerting package itself reads no environment: the transport and its
# credentials are supplied by the caller (ADR-018).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CHANNELFLOW_CHART_BASE_URL=

# The Kafka-protocol event backbone (ADR-063).
REDPANDA_PORT=19092

# The application services (REQ-WP-064). The API reads its catalog URI and
# warehouse from the environment and refuses to start without them; the compose
# file composes both from the values above, so there is one set of credentials
# rather than two spellings of one.
API_PORT=8000
WEB_PORT=8080

# The ingest daemon (REQ-WP-066, REQ-WP-076). One symbol per process; a minute
# of bars so a chart shows its first candle a minute after the stack starts.
CHANNELFLOW_INGEST_SYMBOLS=BTCUSDT
# Which venue the daemon connects to (binance, bybit, okx). Each process
# connects to one venue; the compose file names the venue per service.
CHANNELFLOW_INGEST_VENUE=binance
# §5.1 names three symbols. One process each: `ingest_main` refuses a
# configuration naming more than one, so each variable feeds one service.
CHANNELFLOW_INGEST_SYMBOLS_ETH=ETHUSDT
CHANNELFLOW_INGEST_SYMBOLS_SOL=SOLUSDT
# Phase 2 venues (REQ-WP-076): Bybit and OKX. Each gets its own symbol var.
CHANNELFLOW_INGEST_SYMBOLS_BYBIT=BTCUSDT
CHANNELFLOW_INGEST_SYMBOLS_OKX=BTC-USDT-SWAP
CHANNELFLOW_INGEST_TIMEFRAME_NS=60000000000

# How long a connection can be silent before a warning is logged (REQ-WP-076).
# Multiplied by the venue's idle_timeout_ns: 2.0 means warn after 2x the
# venue's configured idle timeout.
CHANNELFLOW_SILENCE_WINDOW_MULTIPLIER=2.0

# What the resampler produces (REQ-WP-073). `1m` is the source the ingest daemon
# writes and is deliberately absent here; every other timeframe is built from
# those minutes. `1M` is refused by the parser: a calendar month has no fixed
# nanosecond duration.
CHANNELFLOW_TIMEFRAMES=5m,15m,30m,1h,4h,1d,1w
CHANNELFLOW_RESAMPLE_INTERVAL=5m

# What the channel pass produces (REQ-WP-077). PRD §6.2 lists `worker` and
# §5.1 names the set of timeframes. `1m` is the source the ingest daemon
# writes; this variable names the interval the worker runs.
#
# The interval is the same grammar as `CHANNELFLOW_RESAMPLE_INTERVAL`.
CHANNELFLOW_CHANNEL_INTERVAL=5m

# Lakehouse maintenance (REQ-WP-070). Without it a deployment gets slower and
# larger at once. Leave CHANNELFLOW_KEEP_DAYS empty to compact without expiring
# anything: expiry is the only operation in this system that destroys.
CHANNELFLOW_MAINTENANCE_INTERVAL=6h
CHANNELFLOW_KEEP_DAYS=

# Observability (REQ-WP-056). Prometheus scrapes the API's exposition and
# Grafana renders the dashboard generated from the code's own definition.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana's credential. Anonymous access is off unless GRAFANA_ANONYMOUS is set
# (REQ-WP-072): the previous default was an anonymous *admin* with the login
# form disabled, which was defensible on a laptop and nowhere else.
GRAFANA_ADMIN_PASSWORD=channelflow_dev_only
GRAFANA_ANONYMOUS=false
