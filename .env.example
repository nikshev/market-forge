# Development-only defaults for the local stack (REQ-WP-001, FR-006).
# Copy to .env and edit only if a port clashes. Never commit .env.

# Where the stack keeps its data (REQ-WP-065). A directory, not a Docker named
# volume, so it can be moved, copied and backed up with ordinary tools. On a
# server set this to the mounted disk; `make data-dirs` prepares it.
CHANNELFLOW_DATA_DIR=./data

# What address every published port binds to (REQ-WP-072, PRD §34). The default
# means the stack is reachable only from the host itself -- over an SSH tunnel,
# or by another container on the same network. Set it to 0.0.0.0 only when you
# have decided a service should be reachable from elsewhere, and remember that
# Docker's published ports bypass the INPUT chain `ufw` manages by default.
CHANNELFLOW_BIND_ADDRESS=127.0.0.1

# The public read API's limits (PRD §34, Principle X). CHANNELFLOW_RATE_LIMIT
# empty means no limiting at all -- a state chosen by leaving it unset, never a
# number nobody picked. /readyz and /metrics are never limited.
# CHANNELFLOW_CORS_ORIGINS is a comma-separated list; empty allows no
# cross-origin read at all, and "*" is refused at startup.
CHANNELFLOW_CORS_ORIGINS=
CHANNELFLOW_RATE_LIMIT=
CHANNELFLOW_RATE_WINDOW_SECONDS=60

POSTGRES_USER=channelflow
POSTGRES_PASSWORD=channelflow_dev_only
POSTGRES_DB=channelflow
POSTGRES_PORT=5432

MINIO_ROOT_USER=channelflow
MINIO_ROOT_PASSWORD=channelflow_dev_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=channelflow-dev

# Telegram alerting (REQ-WP-008). Names only -- never paste a real token here.
# The alerting package itself reads no environment: the transport and its
# credentials are supplied by the caller (ADR-018).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CHANNELFLOW_CHART_BASE_URL=

# The Telegram Mini App (REQ-WP-080). `off` leaves the read API open, as it has always been;
# `required` makes it refuse every /api/v1 request that Telegram did not sign, and the service will not
# start without the bot's secret named above: one secret, one name.
CHANNELFLOW_TELEGRAM_AUTH=off
# How old a signed launch may be, in seconds. Empty means 86400 (a day).
CHANNELFLOW_TELEGRAM_MAX_AGE_SECONDS=
# The Cloudflare Tunnel in front of the web service, started only by
# `docker compose --profile telegram up -d --build`. Names only: the secret goes into `.env`, which is
# not committed, never here.
CHANNELFLOW_TUNNEL_TOKEN=
CHANNELFLOW_TUNNEL_PROTOCOL=http2

# The Kafka-protocol event backbone (ADR-063).
REDPANDA_PORT=19092

# The application services (REQ-WP-064). The API reads its catalog URI and
# warehouse from the environment and refuses to start without them; the compose
# file composes both from the values above, so there is one set of credentials
# rather than two spellings of one.
API_PORT=8000
WEB_PORT=8080

# The ingest daemon (REQ-WP-066, REQ-WP-076). One symbol per process; a minute
# of bars so a chart shows its first candle a minute after the stack starts.
CHANNELFLOW_INGEST_SYMBOLS=BTCUSDT
# Which venue the daemon connects to (binance, bybit, okx). Each process
# connects to one venue; the compose file names the venue per service.
CHANNELFLOW_INGEST_VENUE=binance
# §5.1 names three symbols. One process each: `ingest_main` refuses a
# configuration naming more than one, so each variable feeds one service.
CHANNELFLOW_INGEST_SYMBOLS_ETH=ETHUSDT
CHANNELFLOW_INGEST_SYMBOLS_SOL=SOLUSDT
# Phase 2 venues (REQ-WP-076): Bybit and OKX. Each gets its own symbol var.
CHANNELFLOW_INGEST_SYMBOLS_BYBIT=BTCUSDT
CHANNELFLOW_INGEST_SYMBOLS_OKX=BTC-USDT-SWAP
CHANNELFLOW_INGEST_TIMEFRAME_NS=60000000000

# How long a feed may be silent before the session reconnects, in seconds
# (REQ-WP-078). Empty leaves each venue's own value: 60 s on all three, from the
# longest real gaps measured in the raw archive (22.2 s on Bybit BTCUSDT, 11.2 s on
# SOLUSDT). A thinner symbol may need more. Shorter than the venue's ping interval is
# refused at start-up: it would reconnect a healthy quiet connection between two pongs.
# Replaces CHANNELFLOW_SILENCE_WINDOW_MULTIPLIER, which multiplied a quantity that
# meant something different on each venue and was never forwarded to a container.
CHANNELFLOW_INGEST_MAX_SILENCE_SECONDS=

# The volume profile's price bins (REQ-WP-089, PRD §14.1). Widths are quote units per bin, per symbol, as
# `venue:SYMBOL=width` separated by commas; unset or empty derives each symbol's from its first trade (about two
# basis points of the price, rounded to 1-2-5). The block length is in seconds, a whole number of minutes; unset is 300.
CHANNELFLOW_PROFILE_BIN_WIDTHS=
CHANNELFLOW_PROFILE_BLOCK_SECONDS=

# The chart's live refresh interval in milliseconds (REQ-WP-090, Principle X). Default 60000 (60 s).
# <=0 or unparseable disables the timer.
VITE_CHART_REFRESH_MS=60000

# The ingest daemons' log level: DEBUG, INFO, WARNING, ERROR or CRITICAL. Empty is INFO.
# At INFO a service writes events -- connect, reconnect, recovery, a refusal from the
# venue -- and nothing per trade; DEBUG brings the per-trade lines back.
CHANNELFLOW_LOG_LEVEL=

# Every service's container log is capped at MAX_FILE files of MAX_SIZE each (REQ-WP-078).
# 60 MB a service by default. A cap applies to a container when it is created, so
# changing these takes effect on `docker compose up -d`.
CHANNELFLOW_LOG_MAX_SIZE=20m
CHANNELFLOW_LOG_MAX_FILE=3

# What the resampler produces (REQ-WP-073). `1m` is the source the ingest daemon
# writes and is deliberately absent here; every other timeframe is built from
# those minutes. `1M` is refused by the parser: a calendar month has no fixed
# nanosecond duration.
CHANNELFLOW_TIMEFRAMES=5m,15m,30m,1h,4h,1d,1w
CHANNELFLOW_RESAMPLE_INTERVAL=5m

# What the channel pass produces (REQ-WP-077). PRD §6.2 lists `worker` and
# §5.1 names the set of timeframes. `1m` is the source the ingest daemon
# writes; this variable names the interval the worker runs.
#
# The interval is the same grammar as `CHANNELFLOW_RESAMPLE_INTERVAL`.
CHANNELFLOW_CHANNEL_INTERVAL=5m

# What the cross-venue consensus pass produces (REQ-WP-091, PRD §17.1). The
# worker runs at this interval, the same grammar as `CHANNELFLOW_CHANNEL_INTERVAL`.
# A quote older than `CHANNELFLOW_CONSENSUS_STALENESS_NS` at the bar close is
# excluded from the median with its reason stated, never silently kept.
CHANNELFLOW_CONSENSUS_INTERVAL=5m
CHANNELFLOW_CONSENSUS_STALENESS_NS=60000000000

# How large a hole in the bar series the extremum detector and the channel fit
# treat as contiguous before they restart at it (REQ-WP-087, Principle X).
# 1, the default, bridges a single missing bar and restarts on two or more;
# 0 restarts on any gap; a larger value bridges up to that many missing bars.
# A restart ends the model's state -- the detector forgets its direction and
# running extreme, the channel fits only to bars after the hole -- so nothing
# is built on bars from both sides of a hole.
CHANNELFLOW_GAP_THRESHOLD=1

# Lakehouse maintenance (REQ-WP-070). Without it a deployment gets slower and
# larger at once. Leave CHANNELFLOW_KEEP_DAYS empty to compact without expiring
# anything: expiry is the only operation in this system that destroys.
CHANNELFLOW_MAINTENANCE_INTERVAL=6h
CHANNELFLOW_KEEP_DAYS=

# Observability (REQ-WP-056). Prometheus scrapes the API's exposition and
# Grafana renders the dashboard generated from the code's own definition.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana's credential. Anonymous access is off unless GRAFANA_ANONYMOUS is set
# (REQ-WP-072): the previous default was an anonymous *admin* with the login
# form disabled, which was defensible on a laptop and nowhere else.
GRAFANA_ADMIN_PASSWORD=channelflow_dev_only
GRAFANA_ANONYMOUS=false

# The signal notary on Monad testnet (REQ-INFRA-006). `python -m tools.notary.deploy`
# reads these; nothing here is a secret. The signer is a Foundry keystore
# *account name* and the *path* of a file holding its password -- never a key
# (`cast wallet import <name> -i` once, through a terminal). A key in the
# environment is not read.
#
# Network. Defaults are the published Monad testnet values.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# Where a transaction hash is opened (`<base>/tx/<hash>`).
MONAD_EXPLORER_URL=https://testnet.monadvision.com
# Required to deploy, verify or smoke-test. Not defaulted on purpose.
MONAD_SIGNER_ACCOUNT=
MONAD_SIGNER_PASSWORD_FILE=
# The one account the contract lets write. Empty means the signer's own address.
MONAD_NOTARY_OWNER=
# The deployed contract. Set ONLY after `python -m tools.notary.deploy --broadcast`
# has read the deployment back from the chain, and equal to the `address` in
# deployments/monad-testnet.json (a test fails if the two disagree or only one
# exists). Empty means no deployment has happened.
MONAD_NOTARY_ADDRESS=0x4a0963b8B35311411Bf17497F0CAeD20d5596682

# The notary service and the worker's registration of records (REQ-INFRA-007). Off unless
# CHANNELFLOW_NOTARY_ENABLED is true, and then CHANNELFLOW_NOTARY_FROM -- the instant from which
# records are notarized, ISO-8601 with a timezone -- is required: there is no default, because
# "when the process started" would move on every restart. Set it ONCE, here, and leave it: a value
# exported at deploy time overrides this file and moves the epoch, leaving records unregistered.
# The build's commit (CHANNELFLOW_CODE_COMMIT) and whether the tree was clean
# (CHANNELFLOW_CODE_DIRTY) come from `make notary-build-info` at each build, never from this file.
# The service starts only when asked for: `docker compose up -d notary`.
CHANNELFLOW_NOTARY_ENABLED=false
CHANNELFLOW_NOTARY_FROM=
CHANNELFLOW_CODE_COMMIT=
CHANNELFLOW_CODE_DIRTY=
# Where the signing material is: files outside the repository, readable by uid 10001, mode 400.
# A key is never an environment value.
MONAD_KEYSTORE_FILE=
# The block the contract was deployed in (deployments/monad-testnet.json, `block_number`).
MONAD_NOTARY_DEPLOY_BLOCK=
# One root per window; a record waits at most this long after the worker recorded it.
CHANNELFLOW_NOTARY_BATCH_WINDOW=30m
CHANNELFLOW_NOTARY_INTERVAL=60
CHANNELFLOW_NOTARY_MAX_BATCH=5000
# In wei. Below the floor nothing is sent and the batch is held with the reason recorded.
CHANNELFLOW_NOTARY_MIN_BALANCE=100000000000000000
CHANNELFLOW_NOTARY_MAX_GAS_PRICE=500000000000
# Monad bills the gas limit, not the gas used: the limit is the estimate times this.
CHANNELFLOW_NOTARY_GAS_MARGIN=1.05
CHANNELFLOW_NOTARY_SUBMIT_TIMEOUT=120
NOTARY_METRICS_PORT=8001
